// Jalur keluar folder js (./../) -> masuk ke events/sports/sports-data.js
import { sportsConfig } from './../events/sports/sports-data.js';

document.addEventListener('DOMContentLoaded', () => {
  const categorySelect = document.getElementById('eventCategory');
  const sportGroup = document.getElementById('sportCompetitionGroup');
  const sportSelect = document.getElementById('sportType');
  const subCategoryGroup = document.getElementById('sportSubCategoryGroup');
  const subCategorySelect = document.getElementById('sportSubCategory');
  const formatGroup = document.getElementById('sportFormatGroup');
  const formatSelect = document.getElementById('sportFormat');
  const eventForm = document.getElementById('eventForm');

  function loadSportsOptions() {
    sportSelect.innerHTML = '<option value="">-- Pilih Olahraga --</option>';
    Object.keys(sportsConfig).forEach(key => {
      const opt = document.createElement('option');
      opt.value = key;
      opt.textContent = sportsConfig[key].name;
      sportSelect.appendChild(opt);
    });
  }

  categorySelect.addEventListener('change', (e) => {
    if (e.target.value === 'sport') {
      loadSportsOptions();
      sportGroup.classList.remove('hidden');
      sportSelect.setAttribute('required', 'true');
    } else {
      resetSportInputs();
    }
  });

  sportSelect.addEventListener('change', (e) => {
    const selectedKey = e.target.value;
    const sport = sportsConfig[selectedKey];

    if (sport) {
      subCategorySelect.innerHTML = '<option value="">-- Pilih Divisi --</option>';
      sport.subCategories.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item;
        opt.textContent = item;
        subCategorySelect.appendChild(opt);
      });
      subCategoryGroup.classList.remove('hidden');
      subCategorySelect.setAttribute('required', 'true');

      formatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
      sport.formats.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item;
        opt.textContent = item;
        formatSelect.appendChild(opt);
      });
      formatGroup.classList.remove('hidden');
      formatSelect.setAttribute('required', 'true');
    } else {
      subCategoryGroup.classList.add('hidden');
      formatGroup.classList.add('hidden');
    }
  });

  function resetSportInputs() {
    sportGroup.classList.add('hidden');
    subCategoryGroup.classList.add('hidden');
    formatGroup.classList.add('hidden');
    sportSelect.removeAttribute('required');
    subCategorySelect.removeAttribute('required');
    formatSelect.removeAttribute('required');
  }

  eventForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const category = categorySelect.value;
    
    const eventPayload = {
      eventName: document.getElementById('eventName').value,
      organizer: document.getElementById('eventOrganizer').value,
      location: document.getElementById('eventLocation').value,
      category: category,
      sportDetails: category === 'sport' ? {
        type: sportsConfig[sportSelect.value].name,
        division: subCategorySelect.value,
        format: formatSelect.value
      } : null
    };

    localStorage.setItem('activeEvent', JSON.stringify(eventPayload));

    if (category === 'sport') {
      // Menggunakan relative path ke sub-direktori
      window.location.href = './events/sports/bracket.html';
    } else {
      alert(`Event "${eventPayload.eventName}" berhasil disimpan!`);
    }
  });
});

