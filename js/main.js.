// Data untuk dropdown olahraga
const sportData = {
  "Sepak Bola": {
    divisions: ["U-17", "U-23", "Umum"],
    formats: ["7 vs 7", "9 vs 9", "11 vs 11"]
  },
  "Futsal": {
    divisions: ["U-17", "U-23", "Umum"],
    formats: ["5 vs 5"]
  },
  "Basket": {
    divisions: ["Putra", "Putri", "Campuran"],
    formats: ["3x3", "5x5"]
  },
  "Badminton": {
    divisions: ["Tunggal Putra", "Tunggal Putri", "Ganda Putra", "Ganda Putri", "Ganda Campuran"],
    formats: ["Set 21 poin", "Set 15 poin", "Best of 3"]
  },
  "Voli": {
    divisions: ["Putra", "Putri"],
    formats: ["Indoor", "Pantai"]
  }
};

// Elemen DOM
const categorySelect = document.getElementById('eventCategory');
const sportTypeSelect = document.getElementById('sportType');
const sportSubCategorySelect = document.getElementById('sportSubCategory');
const sportFormatSelect = document.getElementById('sportFormat');
const sportGroups = [
  document.getElementById('sportCompetitionGroup'),
  document.getElementById('sportSubCategoryGroup'),
  document.getElementById('sportFormatGroup')
];

// Fungsi untuk menampilkan/menyembunyikan field olahraga
function toggleSportFields(show) {
  sportGroups.forEach(group => {
    if (show) {
      group.classList.remove('hidden');
    } else {
      group.classList.add('hidden');
    }
  });
  
  if (!show) {
    // Reset dropdown olahraga
    sportTypeSelect.innerHTML = '';
    sportSubCategorySelect.innerHTML = '';
    sportFormatSelect.innerHTML = '';
  }
}

// Fungsi untuk mengisi dropdown cabang olahraga
function populateSportTypes() {
  sportTypeSelect.innerHTML = '<option value="">-- Pilih Cabang --</option>';
  Object.keys(sportData).forEach(sport => {
    const option = document.createElement('option');
    option.value = sport;
    option.textContent = sport;
    sportTypeSelect.appendChild(option);
  });
  
  // Reset dropdown divisi dan format
  sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi --</option>';
  sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
}

// Fungsi untuk mengisi dropdown divisi berdasarkan cabang
function populateDivisions(sport) {
  sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi --</option>';
  
  if (sport && sportData[sport]) {
    sportData[sport].divisions.forEach(division => {
      const option = document.createElement('option');
      option.value = division;
      option.textContent = division;
      sportSubCategorySelect.appendChild(option);
    });
  }
}

// Fungsi untuk mengisi dropdown format berdasarkan cabang
function populateFormats(sport) {
  sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
  
  if (sport && sportData[sport]) {
    sportData[sport].formats.forEach(format => {
      const option = document.createElement('option');
      option.value = format;
      option.textContent = format;
      sportFormatSelect.appendChild(option);
    });
  }
}

// Event listener untuk kategori
categorySelect.addEventListener('change', function() {
  if (this.value === 'sport') {
    toggleSportFields(true);
    populateSportTypes();
  } else {
    toggleSportFields(false);
  }
});

// Event listener untuk cabang olahraga
sportTypeSelect.addEventListener('change', function() {
  populateDivisions(this.value);
  populateFormats(this.value);
});

// Event listener untuk form submission
document.getElementById('eventForm').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const formData = {
    eventName: document.getElementById('eventName').value,
    eventOrganizer: document.getElementById('eventOrganizer').value,
    eventLocation: document.getElementById('eventLocation').value,
    eventCategory: categorySelect.value,
  };
  
  // Tambahkan data olahraga jika kategori sport
  if (categorySelect.value === 'sport') {
    formData.sportType = sportTypeSelect.value;
    formData.sportSubCategory = sportSubCategorySelect.value;
    formData.sportFormat = sportFormatSelect.value;
  }
  
  // Tampilkan data (bisa diganti dengan API call)
  console.log('Data Event:', formData);
  alert('Event berhasil disimpan!');
  
  // Reset form (opsional)
  // this.reset();
  // toggleSportFields(false);
});
