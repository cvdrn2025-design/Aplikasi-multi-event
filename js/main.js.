// js/main.js - Versi lengkap dengan UI feedback
import { sportsConfig } from './sportsConfig.js';

class EventForm {
  constructor() {
    this.form = document.getElementById('eventForm');
    this.categorySelect = document.getElementById('eventCategory');
    this.sportFields = {
      container: [
        document.getElementById('sportCompetitionGroup'),
        document.getElementById('sportSubCategoryGroup'),
        document.getElementById('sportFormatGroup')
      ],
      type: document.getElementById('sportType'),
      subCategory: document.getElementById('sportSubCategory'),
      format: document.getElementById('sportFormat')
    };
    
    this.init();
  }
  
  init() {
    this.setupEventListeners();
    this.toggleSportFields(false);
    console.log('🏟️ Event Form initialized');
    console.log('📋 Available sports:', Object.keys(sportsConfig));
  }
  
  setupEventListeners() {
    // Kategori event change
    this.categorySelect.addEventListener('change', (e) => {
      const isSport = e.target.value === 'sport';
      this.toggleSportFields(isSport);
      if (isSport) this.populateSportTypes();
    });
    
    // Cabang olahraga change
    this.sportFields.type.addEventListener('change', (e) => {
      this.populateSubCategories(e.target.value);
      this.populateFormats(e.target.value);
    });
    
    // Form submit
    this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    
    // Real-time validation feedback
    this.setupRealTimeValidation();
  }
  
  setupRealTimeValidation() {
    const inputs = this.form.querySelectorAll('input, select');
    inputs.forEach(input => {
      input.addEventListener('blur', () => {
        if (input.hasAttribute('required') && !input.value.trim()) {
          input.style.borderColor = '#ff4444';
          input.style.backgroundColor = '#fff5f5';
        } else {
          input.style.borderColor = '#4CAF50';
          input.style.backgroundColor = '#f0fff0';
        }
      });
      
      input.addEventListener('focus', () => {
        input.style.borderColor = '#667eea';
        input.style.backgroundColor = 'white';
      });
    });
  }
  
  toggleSportFields(show) {
    this.sportFields.container.forEach(field => {
      field.classList.toggle('hidden', !show);
    });
    
    if (!show) {
      this.sportFields.type.innerHTML = '<option value="">-- Pilih Cabang Olahraga --</option>';
      this.sportFields.subCategory.innerHTML = '<option value="">-- Pilih Divisi / Nomor --</option>';
      this.sportFields.format.innerHTML = '<option value="">-- Pilih Format --</option>';
    }
  }
  
  populateSportTypes() {
    this.sportFields.type.innerHTML = '<option value="">-- Pilih Cabang Olahraga --</option>';
    
    Object.entries(sportsConfig).forEach(([key, value]) => {
      const option = new Option(value.name, key);
      this.sportFields.type.add(option);
    });
  }
  
  populateSubCategories(sportKey) {
    this.sportFields.subCategory.innerHTML = '<option value="">-- Pilih Divisi / Nomor --</option>';
    
    if (sportKey && sportsConfig[sportKey]) {
      sportsConfig[sportKey].subCategories.forEach(subCat => {
        const option = new Option(subCat, subCat);
        this.sportFields.subCategory.add(option);
      });
    }
  }
  
  populateFormats(sportKey) {
    this.sportFields.format.innerHTML = '<option value="">-- Pilih Format --</option>';
    
    if (sportKey && sportsConfig[sportKey]) {
      sportsConfig[sportKey].formats.forEach(format => {
        const option = new Option(format, format);
        this.sportFields.format.add(option);
      });
    }
  }
  
  collectFormData() {
    const data = {
      eventName: document.getElementById('eventName').value.trim(),
      eventOrganizer: document.getElementById('eventOrganizer').value.trim(),
      eventLocation: document.getElementById('eventLocation').value.trim(),
      eventCategory: this.categorySelect.value,
      timestamp: new Date().toISOString()
    };
    
    if (data.eventCategory === 'sport') {
      const sportKey = this.sportFields.type.value;
      data.sportDetails = {
        sportKey: sportKey,
        sportName: sportsConfig[sportKey]?.name || '',
        subCategory: this.sportFields.subCategory.value,
        format: this.sportFields.format.value
      };
    }
    
    return data;
  }
  
  validateForm(data) {
    const errors = [];
    
    if (!data.eventName || data.eventName.length < 3) {
      errors.push('Nama event minimal 3 karakter');
    }
    
    if (!data.eventOrganizer) {
      errors.push('Nama penyelenggara wajib diisi');
    }
    
    if (!data.eventLocation) {
      errors.push('Lokasi event wajib diisi');
    }
    
    if (!data.eventCategory) {
      errors.push('Kategori event wajib dipilih');
    }
    
    if (data.eventCategory === 'sport') {
      if (!data.sportDetails?.sportKey) {
        errors.push('Cabang olahraga wajib dipilih');
      }
      if (!data.sportDetails?.subCategory) {
        errors.push('Divisi/nomor wajib dipilih');
      }
      if (!data.sportDetails?.format) {
        errors.push('Format pertandingan wajib dipilih');
      }
    }
    
    if (errors.length > 0) {
      alert('Validasi gagal:\n\n' + errors.join('\n'));
      return false;
    }
    
    return true;
  }
  
  async handleSubmit(e) {
    e.preventDefault();
    
    const submitBtn = this.form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    
    // Disable button dan tampilkan loading
    submitBtn.disabled = true;
    submitBtn.textContent = '⏳ Menyimpan...';
    submitBtn.style.opacity = '0.7';
    
    try {
      const formData = this.collectFormData();
      
      if (!this.validateForm(formData)) {
        throw new Error('Validasi gagal');
      }
      
      // Simulasi API call
      await new Promise(resolve => setTimeout(resolve, 1500));
      
      // Tampilkan hasil
      console.log('✅ Event tersimpan:', formData);
      
      // Tampilkan ringkasan
      const summary = this.generateSummary(formData);
      alert(summary);
      
      // Reset form
      this.form.reset();
      this.toggleSportFields(false);
      
      // Tampilkan pesan sukses
      this.showToast('Event berhasil disimpan!', 'success');
      
    } catch (error) {
      console.error('❌ Error:', error);
      if (error.message !== 'Validasi gagal') {
        this.showToast('Terjadi kesalahan: ' + error.message, 'error');
      }
    } finally {
      // Restore button
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
      submitBtn.style.opacity = '1';
    }
  }
  
  generateSummary(data) {
    let summary = '📋 RINGKASAN EVENT\n';
    summary += '━━━━━━━━━━━━━━━━━━━━\n\n';
    summary += `📌 Nama Event: ${data.eventName}\n`;
    summary += `👥 Penyelenggara: ${data.eventOrganizer}\n`;
    summary += `📍 Lokasi: ${data.eventLocation}\n`;
    summary += `🏷️ Kategori: ${data.eventCategory === 'sport' ? 'Olahraga' : 'Musik & Konser'}\n`;
    
    if (data.sportDetails) {
      summary += `\n🏆 DETAIL OLAHRAGA\n`;
      summary += `━━━━━━━━━━━━━━━━━━━━\n`;
      summary += `🎯 Cabang: ${data.sportDetails.sportName}\n`;
      summary += `👥 Divisi: ${data.sportDetails.subCategory}\n`;
      summary += `📊 Format: ${data.sportDetails.format}\n`;
    }
    
    summary += `\n⏰ Dibuat: ${new Date(data.timestamp).toLocaleString('id-ID')}\n`;
    
    return summary;
  }
  
  showToast(message, type = 'info') {
    // Buat elemen toast
    const toast = document.createElement('div');
    toast.textContent = message;
    toast.style.cssText = `
      position: fixed;
      top: 20px;
      right: 20px;
      padding: 15px 20px;
      border-radius: 8px;
      color: white;
      font-weight: 600;
      z-index: 1000;
      animation: slideIn 0.3s ease;
      background: ${type === 'success' ? '#4CAF50' : type === 'error' ? '#f44336' : '#2196F3'};
    `;
    
    document.body.appendChild(toast);
    
    // Hapus setelah 3 detik
    setTimeout(() => {
      toast.style.animation = 'slideOut 0.3s ease';
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }
}

// Inisialisasi form
document.addEventListener('DOMContentLoaded', () => {
  new EventForm();
});

// Export untuk testing
export default EventForm;
