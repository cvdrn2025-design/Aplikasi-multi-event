// js/main.js
import { sportsConfig } from './sportsConfig.js';

// DOM Elements
const eventForm = document.getElementById('eventForm');
const categorySelect = document.getElementById('eventCategory');
const sportCompetitionGroup = document.getElementById('sportCompetitionGroup');
const sportSubCategoryGroup = document.getElementById('sportSubCategoryGroup');
const sportFormatGroup = document.getElementById('sportFormatGroup');
const sportTypeSelect = document.getElementById('sportType');
const sportSubCategorySelect = document.getElementById('sportSubCategory');
const sportFormatSelect = document.getElementById('sportFormat');

// State management
let currentSport = null;

/**
 * Menampilkan atau menyembunyikan field olahraga
 * @param {boolean} show - True untuk menampilkan, false untuk menyembunyikan
 */
function toggleSportFields(show) {
  const sportGroups = [
    sportCompetitionGroup,
    sportSubCategoryGroup,
    sportFormatGroup
  ];
  
  sportGroups.forEach(group => {
    if (show) {
      group.classList.remove('hidden');
    } else {
      group.classList.add('hidden');
    }
  });
  
  if (!show) {
    resetSportFields();
  }
}

/**
 * Reset semua field olahraga ke kondisi awal
 */
function resetSportFields() {
  sportTypeSelect.innerHTML = '<option value="">-- Pilih Cabang Olahraga --</option>';
  sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi / Nomor --</option>';
  sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
  currentSport = null;
}

/**
 * Mengisi dropdown cabang olahraga berdasarkan sportsConfig
 */
function populateSportTypes() {
  sportTypeSelect.innerHTML = '<option value="">-- Pilih Cabang Olahraga --</option>';
  
  Object.entries(sportsConfig).forEach(([key, value]) => {
    const option = document.createElement('option');
    option.value = key;
    option.textContent = value.name;
    sportTypeSelect.appendChild(option);
  });
  
  // Reset sub-category dan format
  sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi / Nomor --</option>';
  sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
}

/**
 * Mengisi dropdown sub-kategori berdasarkan cabang olahraga yang dipilih
 * @param {string} sportKey - Key dari sportsConfig
 */
function populateSubCategories(sportKey) {
  sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi / Nomor --</option>';
  
  if (sportKey && sportsConfig[sportKey]) {
    sportsConfig[sportKey].subCategories.forEach(subCategory => {
      const option = document.createElement('option');
      option.value = subCategory;
      option.textContent = subCategory;
      sportSubCategorySelect.appendChild(option);
    });
  }
}

/**
 * Mengisi dropdown format berdasarkan cabang olahraga yang dipilih
 * @param {string} sportKey - Key dari sportsConfig
 */
function populateFormats(sportKey) {
  sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
  
  if (sportKey && sportsConfig[sportKey]) {
    sportsConfig[sportKey].formats.forEach(format => {
      const option = document.createElement('option');
      option.value = format;
      option.textContent = format;
      sportFormatSelect.appendChild(option);
    });
  }
}

/**
 * Mengumpulkan data form untuk disimpan
 * @returns {Object} Data event yang akan disimpan
 */
function collectFormData() {
  const formData = {
    eventName: document.getElementById('eventName').value.trim(),
    eventOrganizer: document.getElementById('eventOrganizer').value.trim(),
    eventLocation: document.getElementById('eventLocation').value.trim(),
    eventCategory: categorySelect.value,
    createdAt: new Date().toISOString()
  };
  
  // Tambahkan data olahraga jika kategori adalah sport
  if (categorySelect.value === 'sport') {
    formData.sportDetails = {
      sportType: sportTypeSelect.value,
      sportName: sportsConfig[sportTypeSelect.value]?.name || '',
      subCategory: sportSubCategorySelect.value,
      format: sportFormatSelect.value
    };
  }
  
  return formData;
}

/**
 * Validasi form sebelum submit
 * @param {Object} formData - Data form yang akan divalidasi
 * @returns {boolean} True jika valid, false jika tidak
 */
function validateForm(formData) {
  // Validasi dasar
  if (!formData.eventName || formData.eventName.length < 3) {
    alert('Nama event minimal 3 karakter!');
    return false;
  }
  
  if (!formData.eventOrganizer) {
    alert('Nama penyelenggara wajib diisi!');
    return false;
  }
  
  if (!formData.eventLocation) {
    alert('Lokasi event wajib diisi!');
    return false;
  }
  
  // Validasi khusus untuk olahraga
  if (formData.eventCategory === 'sport') {
    if (!formData.sportDetails?.sportType) {
      alert('Pilih cabang olahraga terlebih dahulu!');
      return false;
    }
    
    if (!formData.sportDetails?.subCategory) {
      alert('Pilih divisi/nomor pertandingan!');
      return false;
    }
    
    if (!formData.sportDetails?.format) {
      alert('Pilih format pertandingan!');
      return false;
    }
  }
  
  return true;
}

