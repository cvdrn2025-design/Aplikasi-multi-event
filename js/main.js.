// js/main.js
import { sportsConfig } from './sportsConfig.js';

console.log('main.js loaded successfully');
console.log('sportsConfig:', sportsConfig);

// Tunggu DOM siap
document.addEventListener('DOMContentLoaded', function() {
  console.log('DOM loaded');
  
  // Ambil elemen
  const form = document.getElementById('eventForm');
  const submitBtn = document.getElementById('submitBtn');
  const categorySelect = document.getElementById('eventCategory');
  const sportCompetitionGroup = document.getElementById('sportCompetitionGroup');
  const sportSubCategoryGroup = document.getElementById('sportSubCategoryGroup');
  const sportFormatGroup = document.getElementById('sportFormatGroup');
  const sportTypeSelect = document.getElementById('sportType');
  const sportSubCategorySelect = document.getElementById('sportSubCategory');
  const sportFormatSelect = document.getElementById('sportFormat');
  
  console.log('Elements found:', {
    form: !!form,
    submitBtn: !!submitBtn,
    categorySelect: !!categorySelect,
    sportTypeSelect: !!sportTypeSelect
  });
  
  // Fungsi untuk debug
  function showDebug(message) {
    console.log('DEBUG:', message);
    const debugDiv = document.getElementById('debugInfo');
    if (debugDiv) {
      debugDiv.style.display = 'block';
      debugDiv.innerHTML += message + '<br>';
    }
  }
  
  // Toggle field olahraga
  function toggleSportFields(show) {
    console.log('toggleSportFields called with:', show);
    
    if (show) {
      sportCompetitionGroup.classList.remove('hidden');
      sportSubCategoryGroup.classList.remove('hidden');
      sportFormatGroup.classList.remove('hidden');
      populateSportTypes();
    } else {
      sportCompetitionGroup.classList.add('hidden');
      sportSubCategoryGroup.classList.add('hidden');
      sportFormatGroup.classList.add('hidden');
      // Reset dropdowns
      sportTypeSelect.innerHTML = '<option value="">-- Pilih Cabang --</option>';
      sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi --</option>';
      sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
    }
  }
  
  // Populate cabang olahraga
  function populateSportTypes() {
    console.log('populateSportTypes called');
    
    sportTypeSelect.innerHTML = '<option value="">-- Pilih Cabang --</option>';
    
    Object.entries(sportsConfig).forEach(([key, value]) => {
      const option = document.createElement('option');
      option.value = key;
      option.textContent = value.name;
      sportTypeSelect.appendChild(option);
    });
    
    console.log('Sport types populated:', sportTypeSelect.options.length);
  }
  
  // Populate sub kategori
  function populateSubCategories(sportKey) {
    console.log('populateSubCategories called with:', sportKey);
    
    sportSubCategorySelect.innerHTML = '<option value="">-- Pilih Divisi --</option>';
    
    if (sportKey && sportsConfig[sportKey]) {
      sportsConfig[sportKey].subCategories.forEach(subCat => {
        const option = document.createElement('option');
        option.value = subCat;
        option.textContent = subCat;
        sportSubCategorySelect.appendChild(option);
      });
    }
  }
  
  // Populate format
  function populateFormats(sportKey) {
    console.log('populateFormats called with:', sportKey);
    
    sportFormatSelect.innerHTML = '<option value="">-- Pilih Format --</option>';
    
    if (sportKey && sportsConfig[sportKey]) {
      sportsConfig[sportKey].formats.forEach(format => {
        const option = document.createElement('option');
        option.value = format;
        option.textContent = format;
        sportFormatSelect.appendChild(option);
      });
    }
  }
  
  // Event listener untuk kategori
  categorySelect.addEventListener('change', function() {
    console.log('Category changed to:', this.value);
    const isSport = this.value === 'sport';
    toggleSportFields(isSport);
  });
  
  // Event listener untuk cabang olahraga
  sportTypeSelect.addEventListener('change', function() {
    console.log('Sport type changed to:', this.value);
    populateSubCategories(this.value);
    populateFormats(this.value);
  });
  
  // Event listener untuk form submit
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    console.log('Form submitted!');
    
    // Kumpulkan data
    const formData = {
      eventName: document.getElementById('eventName').value,
      eventOrganizer: document.getElementById('eventOrganizer').value,
      eventLocation: document.getElementById('eventLocation').value,
      eventCategory: categorySelect.value
    };
    
    console.log('Form data:', formData);
    
    // Validasi
    if (!formData.eventName || !formData.eventOrganizer || !formData.eventLocation || !formData.eventCategory) {
      alert('Mohon lengkapi semua field yang wajib diisi!');
      return;
    }
    
    // Tambahan validasi untuk olahraga
    if (formData.eventCategory === 'sport') {
      formData.sportType = sportTypeSelect.value;
      formData.sportSubCategory = sportSubCategorySelect.value;
      formData.sportFormat = sportFormatSelect.value;
      
      if (!formData.sportType || !formData.sportSubCategory || !formData.sportFormat) {
        alert('Mohon lengkapi detail olahraga!');
        return;
      }
    }
    
    // Tampilkan hasil
    console.log('Final form data:', formData);
    
    let summary = '📋 EVENT BERHASIL DIBUAT\n\n';
    summary += `Nama Event: ${formData.eventName}\n`;
    summary += `Penyelenggara: ${formData.eventOrganizer}\n`;
    summary += `Lokasi: ${formData.eventLocation}\n`;
    summary += `Kategori: ${formData.eventCategory === 'sport' ? 'Olahraga' : 'Musik & Konser'}\n`;
    
    if (formData.eventCategory === 'sport') {
      summary += `\nDetail Olahraga:\n`;
      summary += `Cabang: ${sportsConfig[formData.sportType]?.name || formData.sportType}\n`;
      summary += `Divisi: ${formData.sportSubCategory}\n`;
      summary += `Format: ${formData.sportFormat}\n`;
    }
    
    alert(summary);
    
    // Reset form (opsional)
    if (confirm('Reset form?')) {
      form.reset();
      toggleSportFields(false);
    }
  });
  
  // Inisialisasi
  console.log('Initializing form...');
  toggleSportFields(false);
  showDebug('Form siap digunakan!');
});
