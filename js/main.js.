/**
 * Reset form setelah berhasil disimpan
 */
function resetForm() {
  eventForm.reset();
  toggleSportFields(false);
  currentSport = null;
}

// Event Listeners

// Kategori event berubah
categorySelect.addEventListener('change', function() {
  const isSport = this.value === 'sport';
  toggleSportFields(isSport);
  
  if (isSport) {
    populateSportTypes();
  }
});

// Cabang olahraga berubah
sportTypeSelect.addEventListener('change', function() {
  currentSport = this.value;
  populateSubCategories(this.value);
  populateFormats(this.value);
});

// Form submission
eventForm.addEventListener('submit', async function(e) {
  e.preventDefault();
  
  // Disable tombol submit untuk mencegah double submit
  const submitButton = this.querySelector('button[type="submit"]');
  submitButton.disabled = true;
  submitButton.textContent = 'Menyimpan...';
  
  try {
    // Kumpulkan dan validasi data
    const formData = collectFormData();
    
    if (!validateForm(formData)) {
      submitButton.disabled = false;
      submitButton.textContent = 'Simpan & Lanjutkan';
      return;
    }
    
    // Simpan data
    const result = await saveEvent(formData);
    
    if (result.success) {
      alert(result.message + '\nID Event: ' + result.eventId);
      
      // Tampilkan ringkasan event
      console.log('Ringkasan Event:', {
        'Nama Event': formData.eventName,
        'Penyelenggara': formData.eventOrganizer,
        'Lokasi': formData.eventLocation,
        'Kategori': formData.eventCategory,
        ...(formData.sportDetails && {
          'Cabang': formData.sportDetails.sportName,
          'Divisi': formData.sportDetails.subCategory,
          'Format': formData.sportDetails.format
        })
      });
      
      // Reset form setelah berhasil
      resetForm();
    }
  } catch (error) {
    console.error('Error menyimpan event:', error);
    alert('Terjadi kesalahan saat menyimpan event. Silakan coba lagi.');
  } finally {
    // Re-enable tombol submit
    submitButton.disabled = false;
    submitButton.textContent = 'Simpan & Lanjutkan';
  }
});

// Inisialisasi awal
document.addEventListener('DOMContentLoaded', function() {
  // Pastikan field olahraga tersembunyi saat pertama kali dimuat
  toggleSportFields(false);
  
  // Log untuk debugging
  console.log('Form event siap digunakan');
  console.log('Konfigurasi olahraga tersedia:', Object.keys(sportsConfig));
});

// Export fungsi untuk testing (opsional)
export {
  toggleSportFields,
  populateSportTypes,
  populateSubCategories,
  populateFormats,
  collectFormData,
  validateForm,
  saveEvent
};
